#!/bin/bash
# Sleep on battery when left alone. Omarchy's idle settings only lock the
# screen (after 5 min, with the display off) and never suspend, so a laptop
# left open and unplugged stays awake until the battery dies. This watches for
# "locked and on battery" and suspends once that has lasted SUSPEND_AFTER
# seconds. Plugging in, or unlocking, resets the count.
# Runs as ~/.config/systemd/user/omarchy-battery-idle-suspend.service.
#
# Test overrides: IDLE_POWER_PATH, IDLE_SUSPEND_CMD, IDLE_LOCKED_CMD,
# IDLE_SUSPEND_AFTER, IDLE_POLL.
set -uo pipefail

POWER_PATH=${IDLE_POWER_PATH:-/sys/class/power_supply}
SUSPEND_CMD=${IDLE_SUSPEND_CMD:-systemctl suspend}
LOCKED_CMD=${IDLE_LOCKED_CMD:-omarchy-shell lock isLocked}
SUSPEND_AFTER=${IDLE_SUSPEND_AFTER:-600}
POLL=${IDLE_POLL:-30}

on_ac() {
  local supply
  for supply in "$POWER_PATH"/*; do
    [[ -r $supply/type && -r $supply/online ]] || continue
    [[ $(<"$supply/type") == Battery ]] && continue
    [[ $(<"$supply/online") == 1 ]] && return 0
  done
  return 1
}

since=0
while true; do
  if ! on_ac && [[ $($LOCKED_CMD 2>/dev/null) == true ]]; then
    now=$(date +%s)
    ((since == 0)) && since=$now
    if ((now - since >= SUSPEND_AFTER)); then
      $SUSPEND_CMD
      # Count again from the wake-up, which still shows the lock screen.
      since=0
      sleep "$POLL"
      continue
    fi
  else
    since=0
  fi
  sleep "$POLL"
done
