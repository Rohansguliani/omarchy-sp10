#!/bin/bash
# Connect to a Wi-Fi network picked in Spotlight. Saved and open networks
# connect directly; one that needs a password (or fails) opens the Wi-Fi
# window (nmrs) instead of a terminal prompt.
#   omarchy-wifi-connect <ssid>

ssid=$1
if [[ -z $ssid || $ssid == -* ]]; then
  exec omarchy-wifi-window
fi

if nmcli --wait 20 device wifi connect "$ssid" >/dev/null 2>&1; then
  notify-send -t 2000 "Wi-Fi" "Connected to $ssid"
else
  exec omarchy-wifi-window
fi
